{
  "batch_size": 1024,
  "epochs": 1000,
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "hidden_size": 512,
  "dropout": 0.1,
  "dim_drug_fp": 1024,
  "dim_drug_seq": 768,
  "dim_drug_gra": 768,
  "dim_drug_gnn": 256,
  "layer_drug": 3,
  "dim_cell_exp": 2086,
  "dim_cell_mu": 1928,
  "dim_cell_nv": 2073,
  "num_attention_heads": 8,
  "num_gar_layers": 5,
  "gar_ffn_mult": 2,
  "num_interaction_types": 5,
  "use_interaction_type_bias": true,
  "use_gate": true,
  "use_depth_residual": true,
  "use_shared_drug_embedding": false,
  "lambda_perm": 0.1,
  "lambda_gate_sparse": 0.0001,
  "lambda_gate_balance": 0.001,
  "use_gate_regularization": true,
  "perm_every": 4,
  "save_aux_during_train": true,
  "early_stop_patience": 20,
  "min_delta": 0.001,
  "use_amp": true,
  "num_workers": 4,
  "gpu_cache": "all",
  "graph_cache_mode": "full_batch",
  "allow_tf32": true,
  "enable_cudnn_benchmark": true
}
